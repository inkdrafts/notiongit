{
  "name": "notiongit",
  "private": true,
  "workspaces": [
    "spikes/libsodium-workers"
  ],
  "scripts": {
    "test": "bun test test/index.test.ts && bun run --filter libsodium-workers-spike test",
    "typecheck": "spikes/libsodium-workers/node_modules/.bin/tsc -p tsconfig.json && bun run --filter libsodium-workers-spike typecheck",
    "build": "spikes/libsodium-workers/node_modules/.bin/wrangler deploy --dry-run --env=\"\"",
    "deploy:dry-run": "bun run build",
    "dev": "spikes/libsodium-workers/node_modules/.bin/wrangler dev"
  },
  "trustedDependencies": [
    "esbuild",
    "workerd"
  ]
}
